@@ -0,0 +1,52 @@
+package rclone
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// isolateVolumeRemotes prevents two StorageClasses named "s3" from sharing
+// rclone's process-wide remote configuration or filesystem cache entries.
+func isolateVolumeRemotes(pvp *publishVolumeParams, volumeID, targetPath string) error {
+	remotes, err := parseAllConfigRemotes(pvp.configData)
+	if err != nil {
+		return err
+	}
+	if _, ok := remotes[pvp.remoteName]; !ok {
+		return fmt.Errorf("selected remote missing from config")
+	}
+	sum := sha256.Sum256([]byte(volumeID + "\x00" + targetPath))
+	suffix := fmt.Sprintf("_%x", sum[:12])
+	names := make([]string, 0, len(remotes))
+	for name := range remotes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var text strings.Builder
+	for _, name := range names {
+		fmt.Fprintf(&text, "[%s%s]\n", name, suffix)
+		keys := make([]string, 0, len(remotes[name]))
+		for key := range remotes[name] {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			value := remotes[name][key]
+			// Wrapper backends reference another remote in their "remote" option.
+			if key == "remote" {
+				for _, other := range names {
+					if strings.HasPrefix(value, other+":") {
+						value = other + suffix + strings.TrimPrefix(value, other)
+						break
+					}
+				}
+			}
+			fmt.Fprintf(&text, "%s = %s\n", key, value)
+		}
+	}
+	pvp.configData = text.String()
+	pvp.remoteName += suffix
+	return nil
+}
