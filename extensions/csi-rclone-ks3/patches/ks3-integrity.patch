diff --git a/vendor/github.com/rclone/rclone/backend/s3/ks3_crc64.go b/vendor/github.com/rclone/rclone/backend/s3/ks3_crc64.go
new file mode 100644
index 00000000..c07d74cb
--- /dev/null
+++ b/vendor/github.com/rclone/rclone/backend/s3/ks3_crc64.go
@@ -0,0 +1,153 @@
+package s3
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"hash"
+	"hash/crc64"
+	"io"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	smithy "github.com/aws/smithy-go"
+	"github.com/aws/smithy-go/middleware"
+	smithyhttp "github.com/aws/smithy-go/transport/http"
+	"github.com/rclone/rclone/fs"
+)
+
+// KS3 ETags are not a portable content MD5. Use its server CRC64 instead.
+func (f *Fs) isKS3() bool {
+	u, err := url.Parse(f.opt.Endpoint)
+	return err == nil && strings.HasPrefix(u.Hostname(), "ks3-") && strings.HasSuffix(u.Hostname(), ".ksyuncs.com")
+}
+
+type ks3CRCKey struct{}
+type ks3CRCResult struct{ value string }
+
+func captureKS3CRC64(result *ks3CRCResult) func(*middleware.Stack) error {
+	return func(stack *middleware.Stack) error {
+		return stack.Deserialize.Add(middleware.DeserializeMiddlewareFunc("KS3CRC64", func(ctx context.Context, in middleware.DeserializeInput, next middleware.DeserializeHandler) (out middleware.DeserializeOutput, meta middleware.Metadata, err error) {
+			out, meta, err = next.HandleDeserialize(ctx, in)
+			if response, ok := out.RawResponse.(*smithyhttp.Response); ok && response != nil {
+				result.value = response.Header.Get("x-kss-checksum-crc64ecma")
+			}
+			return
+		}), middleware.Before)
+	}
+}
+
+type ks3Digest struct {
+	hash.Hash64
+	count int64
+}
+
+func newKS3Digest() *ks3Digest { return &ks3Digest{Hash64: crc64.New(crc64.MakeTable(crc64.ECMA))} }
+func (d *ks3Digest) Write(p []byte) (int, error) {
+	n, e := d.Hash64.Write(p)
+	d.count += int64(n)
+	return n, e
+}
+func (d *ks3Digest) verify(expected string, size int64) error {
+	checksum, err := strconv.ParseUint(expected, 10, 64)
+	if err != nil {
+		return fmt.Errorf("KS3 content verification requires a valid CRC64 response header")
+	}
+	if size != d.count || checksum != d.Sum64() {
+		return fmt.Errorf("KS3 content verification failed: CRC64 or length mismatch")
+	}
+	return nil
+}
+
+var ks3CRCActive, ks3CRCMissing sync.Once
+
+// verifyUpload checks what was sent against the object's size and, when KS3
+// reports one, its CRC64. Without a CRC64 the parts' Content-MD5 is all there is.
+func (d *ks3Digest) verifyUpload(expected string, size *int64) error {
+	if size == nil || *size != d.count {
+		return fmt.Errorf("KS3 upload verification failed: sent %d bytes, object length differs", d.count)
+	}
+	if expected == "" {
+		ks3CRCMissing.Do(func() { fs.Logf(nil, "KS3 returned no CRC64 for an uploaded object: uploads are checked by size only") })
+		return nil
+	}
+	ks3CRCActive.Do(func() { fs.Logf(nil, "KS3 CRC64 upload verification is active") })
+	return d.verify(expected, *size)
+}
+
+type ks3CheckedReader struct {
+	io.ReadCloser
+	digest   *ks3Digest
+	expected string
+	size     int64
+	checked  bool
+	failure  error
+}
+
+func (r *ks3CheckedReader) Read(p []byte) (int, error) {
+	if r.failure != nil {
+		return 0, r.failure
+	}
+	n, err := r.ReadCloser.Read(p)
+	_, _ = r.digest.Write(p[:n])
+	if err == io.EOF || r.digest.count == r.size {
+		r.checked = true
+		r.failure = r.digest.verify(r.expected, r.size)
+		if r.failure != nil {
+			return n, r.failure
+		}
+	}
+	return n, err
+}
+func (r *ks3CheckedReader) Close() error {
+	err := r.ReadCloser.Close()
+	if r.failure != nil {
+		return r.failure
+	}
+	// Closing an intentionally partial read does not claim full-object verification.
+	if r.checked {
+		return r.digest.verify(r.expected, r.size)
+	}
+	return err
+}
+
+func ks3CompleteRead(contentRange *string, length *int64) bool {
+	if contentRange == nil {
+		return true
+	}
+	var start, end, total int64
+	n, err := fmt.Sscanf(*contentRange, "bytes %d-%d/%d", &start, &end, &total)
+	return err == nil && n == 3 && start == 0 && end+1 == total && length != nil && *length == total
+}
+
+// ks3BufferedPutSize bounds the single part uploads held in memory so that a
+// throttled PutObject can be sent again. Unbuffered VFS writes above the
+// streaming cutoff (100 KiB) are multipart, whose parts are already retried.
+const ks3BufferedPutSize = 1 << 20
+
+func (o *Object) ks3PutBuffered(ctx context.Context, req *s3.PutObjectInput, in io.Reader) (etag string, lastModified time.Time, versionID *string, err error) {
+	data, err := io.ReadAll(in)
+	if err != nil {
+		return "", lastModified, nil, err
+	}
+	var resp *s3.PutObjectOutput
+	err = o.fs.pacer.Call(func() (bool, error) {
+		req.Body = bytes.NewReader(data)
+		resp, err = o.fs.c.PutObject(ctx, req)
+		return o.fs.shouldRetry(ctx, err)
+	})
+	if err != nil {
+		return "", lastModified, nil, err
+	}
+	return *stringClone(deref(resp.ETag)), time.Now(), stringClonePointer(resp.VersionId), nil
+}
+
+func ks3AlreadyExists(err error) bool {
+	var apiErr smithy.APIError
+	return errors.As(err, &apiErr) && apiErr.ErrorCode() == "ObjectAlreadyExists"
+}
diff --git a/vendor/github.com/rclone/rclone/backend/s3/ks3_crc64_test.go b/vendor/github.com/rclone/rclone/backend/s3/ks3_crc64_test.go
