index 00000000..e530d90a
--- /dev/null
+++ b/vendor/github.com/rclone/rclone/backend/s3/ks3_crc64_test.go
@@ -0,0 +1,66 @@
+package s3
+
+import (
+	"bytes"
+	"github.com/stretchr/testify/require"
+	"io"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func TestKS3CRC64ContentVerification(t *testing.T) {
+	data := bytes.Repeat([]byte("fleet-ks3-validation-20261112\n"), 16384)
+	digest := newKS3Digest()
+	digest.Write(data)
+	require.Equal(t, uint64(615270568529972801), digest.Sum64())
+	require.NoError(t, digest.verify("615270568529972801", int64(len(data))))
+	for _, expected := range []string{"", "not-a-number", "0"} {
+		require.Error(t, digest.verify(expected, int64(len(data))))
+	}
+	require.Error(t, digest.verify("615270568529972801", 1))
+	for _, valid := range []bool{true, false} {
+		expected := strconv.FormatUint(digest.Sum64(), 10)
+		if !valid {
+			expected = "0"
+		}
+		r := &ks3CheckedReader{ReadCloser: io.NopCloser(bytes.NewReader(data)), digest: newKS3Digest(), expected: expected, size: int64(len(data))}
+		got, err := io.ReadAll(r)
+		if valid {
+			require.NoError(t, err)
+			require.Equal(t, data, got)
+			require.NoError(t, r.Close())
+		} else {
+			require.Error(t, err)
+			require.Error(t, r.Close())
+		}
+	}
+}
+func TestKS3UploadVerification(t *testing.T) {
+	digest := newKS3Digest()
+	digest.Write([]byte("fleet"))
+	size, short := int64(5), int64(4)
+	require.NoError(t, digest.verifyUpload("", &size))
+	require.NoError(t, digest.verifyUpload(strconv.FormatUint(digest.Sum64(), 10), &size))
+	require.Error(t, digest.verifyUpload("1", &size))
+	require.Error(t, digest.verifyUpload("", &short))
+	require.Error(t, digest.verifyUpload("", nil))
+}
+func TestKS3EndpointAndRangeSelection(t *testing.T) {
+	for _, tc := range []struct {
+		endpoint string
+		want     bool
+	}{{"https://ks3-cn-ningxia.ksyuncs.com", true}, {"https://ks3-cn-ningxia-internal.ksyuncs.com", true}, {"https://not-ks3.example.com", false}, {"https://ks3-cn-ningxia.ksyuncs.com.evil.test", false}} {
+		f := &Fs{opt: Options{Endpoint: tc.endpoint}}
+		require.Equal(t, tc.want, f.isKS3())
+	}
+	length := int64(10)
+	full := "bytes 0-9/10"
+	partial := "bytes 1-9/10"
+	require.True(t, ks3CompleteRead(nil, &length))
+	require.True(t, ks3CompleteRead(&full, &length))
+	require.False(t, ks3CompleteRead(&partial, &length))
+	r := &ks3CheckedReader{ReadCloser: io.NopCloser(strings.NewReader("short")), digest: newKS3Digest(), expected: "0", size: 10}
+	_, err := io.ReadAll(r)
+	require.Error(t, err)
+}
