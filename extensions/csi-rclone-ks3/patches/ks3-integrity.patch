@@ -0,0 +1,21 @@
+package rclone
+
+import (
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func TestVolumeRemoteIsolation(t *testing.T) {
+	config := "[s3]\ntype = s3\nendpoint = https://example.test\nsecret_access_key = private\n"
+	a := &publishVolumeParams{remoteName: "s3", configData: config}
+	b := &publishVolumeParams{remoteName: "s3", configData: config}
+	require.NoError(t, isolateVolumeRemotes(a, "pv-a", "/mount-a"))
+	require.NoError(t, isolateVolumeRemotes(b, "pv-b", "/mount-b"))
+	require.NotEqual(t, a.remoteName, b.remoteName)
+	require.Contains(t, a.configData, "secret_access_key = private")
+	require.False(t, strings.Contains(a.configData, b.remoteName))
+	again := &publishVolumeParams{remoteName: "s3", configData: config}
+	require.NoError(t, isolateVolumeRemotes(again, "pv-a", "/mount-a"))
+	require.Equal(t, a.configData, again.configData)
+}
