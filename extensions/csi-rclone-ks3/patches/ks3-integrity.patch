+	"github.com/rclone/rclone/fs/object"
+	"github.com/stretchr/testify/require"
+)
+
+// KS3 answers throttled requests with an HTML page; lists and small uploads must be sent again.
+func TestKS3RetriesThrottledRequests(t *testing.T) {
+	var lists, puts atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := &lists
+		if r.Method == http.MethodPut {
+			n = &puts
+		}
+		if n.Add(1) <= 3 {
+			w.Header().Set("Content-Type", "text/html")
+			w.WriteHeader(http.StatusTooManyRequests)
+			_, _ = w.Write([]byte("<html>\n<body>\n<center><h1>429 Too Many Requests</h1></center>\n<p>x\n</body>\n</html>\n"))
+			return
+		}
+		if r.Method == http.MethodPut || r.Method == http.MethodHead {
+			w.Header().Set("ETag", `"0123456789abcdef0123456789abcdef"`)
+			w.Header().Set("Content-Length", "5")
+			return
+		}
+		_, _ = w.Write([]byte(`<?xml version="1.0" encoding="UTF-8"?><ListBucketResult><Name>bucket</Name><IsTruncated>false</IsTruncated></ListBucketResult>`))
+	}))
+	defer srv.Close()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.LowLevelRetries = 10
+	info, _ := fs.Find("s3")
+	f, err := NewFs(ctx, "ks3", "bucket/dir", fs.ConfigMap(info.Prefix, info.Options, "ks3", configmap.Simple{"provider": "Other", "endpoint": srv.URL, "access_key_id": "a", "secret_access_key": "b", "region": "cn", "no_check_bucket": "true", "force_path_style": "true"}))
+	require.NoError(t, err)
+	// The test server stands in for a ks3-*.ksyuncs.com endpoint.
+	f.(*Fs).opt.Endpoint = "https://ks3-cn-test.ksyuncs.com"
+	f.(*Fs).pacer.SetRetries(ci.LowLevelRetries)
+	lists.Store(0)
+	_, err = f.List(ctx, "")
+	require.NoError(t, err)
+	require.Equal(t, int32(4), lists.Load())
+	_, err = f.Put(ctx, bytes.NewReader([]byte("fleet")), object.NewStaticObjectInfo("small", time.Now(), 5, true, nil, nil))
+	require.NoError(t, err)
+	require.Equal(t, int32(4), puts.Load())
+}
+
+// KS3 refuses CopyObject onto an existing key; a rename over a file must still replace it.
+func TestKS3CopyOntoExistingObject(t *testing.T) {
+	var calls []string
+	exists := true
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls = append(calls, r.Method)
+		switch {
+		case r.Method == http.MethodHead:
+			w.WriteHeader(http.StatusNotFound)
+		case r.Method == http.MethodDelete:
+			exists = false
+			w.WriteHeader(http.StatusNoContent)
+		case r.Method == http.MethodPut && exists:
+			w.Header().Set("Content-Type", "application/xml")
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(`<?xml version="1.0" encoding="UTF-8"?><Error><Code>ObjectAlreadyExists</Code><Message>target object already exists</Message></Error>`))
+		default:
+			_, _ = w.Write([]byte(`<?xml version="1.0" encoding="UTF-8"?><CopyObjectResult><ETag>"0123456789abcdef0123456789abcdef"</ETag></CopyObjectResult>`))
+		}
+	}))
+	defer srv.Close()
+	ctx := context.Background()
+	info, _ := fs.Find("s3")
+	f, err := NewFs(ctx, "ks3copy", "bucket/dir", fs.ConfigMap(info.Prefix, info.Options, "ks3copy", configmap.Simple{"provider": "Other", "endpoint": srv.URL, "access_key_id": "a", "secret_access_key": "b", "region": "cn", "no_check_bucket": "true", "force_path_style": "true"}))
+	require.NoError(t, err)
+	s3fs := f.(*Fs)
+	s3fs.opt.Endpoint = "https://ks3-cn-test.ksyuncs.com"
+	calls = nil
+	bucket, key, source := "bucket", "dir/x", "bucket/dir/x.partial"
+	require.NoError(t, s3fs.copy(ctx, &s3.CopyObjectInput{Bucket: &bucket, Key: &key, CopySource: &source}, bucket, key, bucket, "dir/x.partial", &Object{fs: s3fs, bytes: 5}))
+	require.Equal(t, []string{"PUT", "DELETE", "PUT"}, calls)
+}
