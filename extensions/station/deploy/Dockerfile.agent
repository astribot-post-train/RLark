# Build from the repository root.
FROM golang:1.26 AS build
WORKDIR /src
COPY api/ ./api/
COPY sdks/execution-go/ ./sdks/execution-go/
COPY apps/rlark/ ./apps/rlark/
RUN cd apps/rlark && GOWORK=off CGO_ENABLED=0 go build -trimpath -o /station-agent ./cmd/station-agent
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /station-agent /usr/local/bin/station-agent
ENTRYPOINT ["/usr/local/bin/station-agent"]
